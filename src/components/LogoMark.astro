---
import { brand } from '../data/brand';
import { site } from '../data/site';

interface Props {
  size?: number;
  decorative?: boolean;
  class?: string;
}
const { size = 28, decorative = false, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={className}
  fill="currentColor"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : site.name}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <path d={brand.markPath} />
</svg>
