---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<BaseLayout>
  <header class="page-width site-header" id="top">
    <a class="site-name" href="#top" aria-label={site.name}><Logo /></a>
    <nav class="flex flex-wrap" aria-label="Main navigation">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="#consulting">Consulting</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main" class="page-width" tabindex="-1">
    <section class="introduction" aria-labelledby="intro-title">
      <h1 id="intro-title">{site.name}</h1>
      <p class="intro-copy">
        Independent AI research and engineering studio.
      </p>
      <p class="intro-copy">
        Building technical tools around machine learning, research workflows,
        and AI-assisted software engineering.
      </p>
      <p class="studio-details">
        Founded in {site.founded} by {site.founder} · {site.location}
      </p>
      <p class="intro-consulting">
        <a href={`mailto:${site.email}`}>Get in touch</a>
      </p>
    </section>

    <section id="work" class="selected-work" aria-labelledby="work-title">
      <h2 id="work-title">What we’re building</h2>
      <div class="building-copy">
        <p>
          NhatNam Tech is developing tools for technical research and ML engineering
          workflows, with an initial focus on code reasoning, experiment analysis,
          and reproducible research automation.
        </p>
        <article class="research-tools">
          <h3>Research engineering tools</h3>
          <p>
            Early-stage tools that use modern language models to help inspect technical
            codebases, reason about experiments, analyse results, and automate repetitive
            research-engineering workflows.
          </p>
          <p class="development-status">Early development · 2026</p>
        </article>
      </div>
    </section>

    <section class="research-directions" aria-labelledby="research-title">
      <h2 id="research-title">Research directions</h2>
      <p>Current areas of exploration include:</p>
      <ul>
        <li>Machine learning</li>
        <li>Computer vision and scientific imaging</li>
        <li>Speech and audio</li>
        <li>Efficient ML systems</li>
        <li>Reproducible experimentation</li>
        <li>AI-assisted developer and research tooling</li>
      </ul>
    </section>

    <div class="personal-and-practice">
      <section id="about" class="about" aria-labelledby="about-title">
        <h2 id="about-title">About</h2>
        <p>
          NhatNam Tech is an independent AI research and engineering studio founded
          in {site.founded} by {site.founder} in {site.location}.
        </p>
        <p>
          The studio works at the intersection of machine learning research and systems
          engineering, with particular interests in computer vision, speech processing,
          efficient ML software, and tools for technical research.
        </p>
        <p>
          Nhat-Nam is currently pursuing a PhD in AI and machine learning.
        </p>
      </section>

      <section id="consulting" class="consulting" aria-labelledby="consulting-title">
        <h2 id="consulting-title">Work with NhatNam Tech</h2>
        <p>
          I take on selected research collaborations, technical consulting, and
          early-stage AI engineering work.
        </p>
        <p class="consulting-areas">Areas include:</p>
        <dl>
          <div>
            <dt>Research prototyping</dt>
            <dd>Turning uncertain technical ideas into testable systems.</dd>
          </div>
          <div>
            <dt>ML, vision, and speech engineering</dt>
            <dd>Building and improving software around difficult model and data problems.</dd>
          </div>
          <div>
            <dt>Technical investigation</dt>
            <dd>Profiling, experimentation, model evaluation, and implementation work.</dd>
          </div>
        </dl>
        <p class="consulting-contact"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </section>
    </div>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Have a difficult ML problem?</h2>
      <p>
        For selected technical work or research collaborations, write to{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </section>
  </main>

  <footer class="page-width site-footer flex flex-wrap justify-between">
    <div>
      <p>{site.name}</p>
      <p>Founded {site.founded} · {site.location}</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <p>© {year} {site.name}</p>
  </footer>
</BaseLayout>
